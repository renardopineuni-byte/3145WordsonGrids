-- Contract tests for WordsOnGrid, Game, Player and Play.
-- Open WordsOnGrids_Daunte.use in USE.
-- In the USE shell, run: open WordsOnGrids_Daunte.soil
-- Run in a fresh model session. The script adds fixture objects.
-- Setup calls executable operations. The move tests use openter/opexit.
-- The final command intentionally fails the turn precondition.
-- The example dictionary contains crane.

-- Register the players and confirm duplicate registration returns false.
!create demoSystem : WordsOnGrid
!registration := demoSystem.addPlayer('Daunte')
? registration
!registration := demoSystem.addPlayer('Alex')
? registration
!registration := demoSystem.addPlayer('Daunte')
? registration
!daunte := demoSystem.players->any(p | p.username = 'Daunte')
!alex := demoSystem.players->any(p | p.username = 'Alex')

-- WordsOnGrid creates the game and attaches its dictionary.
!demoSystem.addGame(5, Set{'crane'})
!demoGame := demoSystem.games->any(g | g.id = 1)
!demoGame.addPlayers(Set{daunte, alex})
? demoGame.alphabetForWords()->collect(l | l.getValue())->asSet()
!letter_c := demoGame.alphabetForWords()->any(l | l.getValue() = 'c')
!letter_r := demoGame.alphabetForWords()->any(l | l.getValue() = 'r')

-- The layout has 24 empty cells and e at row 5, column 5.
!demoGame.initialiseBoard(Sequence{'-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', '-', 'e'})
!cell11 := demoGame.cellAt(1, 1)
!cell55 := demoGame.cellAt(5, 5)
? demoGame.gameCells->size() = 25
? demoGame.gameCells->forAll(c | c.play->size() = 1)
? cell11.play->first().playValue.isUndefined()
? cell55.play->first().playValue.getValue() = 'e'
check

!started := demoGame.updateStatus(#Started)
? started
check

-- Expect false for the seeded cell and true for an empty cell.
? demoGame.canPlayAt(5, 5, letter_c)
? demoGame.canPlayAt(1, 1, letter_c)

-- Legal first move. Daunte places 'c' in row 1, column 1.
!openter daunte play(1, 1, 1, letter_c)
!create firstMove : Play
!insert (demoGame, firstMove) into GamePlay
!insert (daunte, firstMove) into WhoPlayed
!insert (cell11, firstMove) into CellPlay
!insert (letter_c, firstMove) into PlayValue
!insert (cell11, letter_c) into CellValue
!opexit
check

-- Play: passing the recorded letter preserves the move.
!openter firstMove updateValue(letter_c)
!opexit

-- Expected: Started, one move by Daunte, and 'c' in the first cell.
? demoGame.status
? cell11.play->size()
? cell55.play->size()
? demoGame.plays->size()
? demoGame.plays->last().player.username
? demoGame.plays->last().playValue = letter_c

-- The target cell and letter are valid, so the failure isolates whose turn it is.
-- Expected: canPlayAt returns true, then Player::play rejects Daunte's second turn.
? demoGame.canPlayAt(1, 2, letter_r)
!openter daunte play(1, 1, 2, letter_r)

-- Optional separate negative test in the USE shell after the script ends.
-- Enter the next command without its comment marker. Expect ValidInput to fail.
-- !openter firstMove updateValue(letter_r)
